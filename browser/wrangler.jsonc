{
  // Worker proxy do Playwright MCP. Secrets NAO ficam aqui: use "wrangler secret put"
  // (MCP_SECRET, JWT_SECRET opcional, CF_ACCESS_CLIENT_ID, CF_ACCESS_CLIENT_SECRET).
  "name": "mcp-browser",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",

  // Somente o dominio proprio; sem URLs workers.dev nem de preview.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mcp-browser.alexcordeiro.dev", "custom_domain": true }],

  // URL do origin protegido pelo Access (nao e secret).
  "vars": { "ORIGIN_URL": "https://browser.alexcordeiro.dev/mcp" },

  // Workers Logs ligado: o console.error do worker (falhas do upstream e de configuracao) aparece no
  // dashboard. O log de invocacao fica desligado para nao gastar a cota diaria de eventos do plano Free.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },

  // Rate limit por IP: 60 chamadas por 60 s. Vale para /register, /authorize, /token e para
  // tentativas de /mcp sem Bearer valido. O codigo ignora o binding se ele nao existir.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ]
}
